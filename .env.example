LOG_LEVEL=info

# On-chain scanning + closing (required)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key_here
WALLET_ADDRESS=your_public_solana_address_here
SOLANA_PRIVATE_KEY=your_wallet_private_key_base58

# Telegram — own bot, separate from any screener/trader bot
TELEGRAM_BOT_TOKEN=your_exitbot_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: override Meteora DLMM datapi host
METEORA_DLMM_HOST=https://dlmm.datapi.meteora.ag
